DATABASE_URL="postgresql://user:password@localhost:5432/company_brain?schema=public"

# Signs the session. In production at least 32 characters, or the server
# refuses to start. Generate one with: openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"

# Encrypts stored two-factor secrets. Optional: without it AUTH_SECRET is used.
# Set it separately if you ever want to rotate one without invalidating every
# enrolled authenticator app.
AUTH_ENCRYPTION_KEY="replace-with-a-separate-32-byte-secret"

OPENAI_API_KEY=""
OPENAI_CHAT_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
RETRIEVAL_THRESHOLD="0.12"

# E-mail and password against the real account table, with scrypt and TOTP.
# This is how people sign in, in development and in production alike. Set it to
# "false" only if every account arrives through an OAuth provider — note that
# accepting an invitation signs the new person in through this provider, so
# switching it off ends the invitation flow with it.
AUTH_PASSWORD_LOGIN_ENABLED="true"

# Development only. Authenticates against the two variables below with no
# database behind it, so a fresh clone can sign in before PostgreSQL is up.
# Ignored when NODE_ENV is production, and setting it there stops the server.
AUTH_DEV_MEMORY_FALLBACK="true"
AUTH_DEV_EMAIL="demo@example-gmbh.local"
AUTH_DEV_PASSWORD="change-this-local-password"

# Optional OAuth provider. Keep credentials server-side only.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
