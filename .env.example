DATABASE_URL="postgresql://user:password@localhost:5432/company_brain?schema=public"
AUTH_SECRET="replace-with-a-long-random-secret"
OPENAI_API_KEY=""
OPENAI_CHAT_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
RETRIEVAL_THRESHOLD="0.12"
AUTH_URL="http://localhost:3000"
AUTH_ENCRYPTION_KEY="replace-with-a-separate-32-byte-secret"

# Local-only Credentials provider. Disabled automatically in production.
AUTH_DEV_LOGIN_ENABLED="true"
AUTH_DEV_EMAIL="demo@example-gmbh.local"
AUTH_DEV_PASSWORD="change-this-local-password"
AUTH_DEV_MEMORY_FALLBACK="true"

# Optional OAuth provider. Keep credentials server-side only.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
